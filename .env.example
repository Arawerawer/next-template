# ==========================================
# 1. Supabase（後台 Connect 或 Project Settings → API Keys）
# ==========================================
# 複製成 .env.local 後填值。NEXT_PUBLIC_ 開頭會在 build 時寫進 bundle，只能放公開的值。
# 部署到 Cloudflare 時，這兩個要設在 Workers Builds 的「Build variables」。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
